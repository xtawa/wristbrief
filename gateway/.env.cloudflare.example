# Copy this file to .env.cloudflare.local and replace only the values you need.
# .env.cloudflare.local is ignored by Git. Do not commit API keys or private keys.

# AI provider secret required by the summary routes.
# AI_API_KEY=replace-with-provider-key

# Optional legacy gateway authentication secret.
# GATEWAY_TOKEN=replace-with-a-long-random-token

# Public transcript reuse is fail-closed. Add only reviewed HTTPS feed hosts.
# PUBLIC_REUSE_FEED_HOSTS=feeds.example.com,podcast.example.org

# Optional Google OAuth client ID (not a private key, but kept here for one-file setup).
# GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id

# Google Play purchase verification secrets.
# GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
# GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-key\n-----END PRIVATE KEY-----"

# Pub/Sub push verification settings.
# PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=service-account@example.iam.gserviceaccount.com
# PUBSUB_PUSH_AUDIENCE=https://api.example.com/api/play/rtdn
