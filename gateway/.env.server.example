# Copy into a private environment file, then load it through your process supervisor.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
WRISTBRIEF_PUBLIC_ORIGIN=https://api.example.com
WRISTBRIEF_DATA_DIR=/var/lib/wristbrief
# Generate: openssl rand -base64 32
WRISTBRIEF_MASTER_KEY=
# Only required on the FIRST launch. Remove it from the process environment after changing password.
WRISTBRIEF_ADMIN_INITIAL_PASSWORD=
FREE_AI_MONTHLY_LIMIT=10
PRO_AI_MONTHLY_LIMIT=100
# Outbound fetch policy (all server-side remote URL fetches). Defaults shown.
# Simultaneous outbound fetches; a burst cannot open unbounded sockets.
WRISTBRIEF_FETCH_CONCURRENCY=8
# Longest input audio the transcript worker will transcode (3 hours).
TRANSCRIPT_MAX_DURATION_MS=10800000
# Hard per-job transcript billing ceiling; beyond it the job is refused and its
# reservation is released with no partial charge.
TRANSCRIPT_MAX_BILLABLE_MINUTES=180
# Crash reclaims allowed before a job fails as audio_attempts_exhausted.
# An explicit user retry is always processed.
TRANSCRIPT_MAX_ATTEMPTS=3
# Job lease length in ms; an expired lease makes an interrupted job reclaimable.
TRANSCRIPT_LEASE_MS=240000
# Optional Android Google sign-in and Play purchase verification:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
PLAY_PACKAGE_NAME=
PLAY_SUBSCRIPTION_PRODUCT_IDS=
PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
PUBSUB_PUSH_AUDIENCE=
